# Copy to .env for local development. Never commit real values.
ENVIRONMENT=development
DATABASE_URL=postgresql://user:password@localhost:5432/crave
OPENROUTER_API_KEY=
MODEL=google/gemini-3.8-flash
FAST_MODEL=google/gemini-3.8-flash
IMAGE_MODEL=google/gemini-nano-banana-2.1
JWT_SECRET=replace-with-a-cryptographically-random-secret
# Used only during local development. Production CORS is pinned in app/main.py.
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,crave-backend-production.up.railway.app
