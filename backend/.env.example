# Copy to .env for local development. Never commit real values.
ENVIRONMENT=development
DATABASE_URL=postgresql://user:password@localhost:5432/crave
OPENROUTER_API_KEY=
MODEL=google/gemini-3.8-flash
FAST_MODEL=google/gemini-3.8-flash
IMAGE_MODEL=google/gemini-nano-banana-2.1
JWT_SECRET=replace-with-a-cryptographically-random-secret
# Exact frontend origin(s), comma-separated. In production: https://<your-frontend-domain>
CORS_ORIGINS=http://localhost:3000
# Public backend hostname(s), comma-separated, no scheme. localhost/127.0.0.1 are always allowed.
ALLOWED_HOSTS=localhost,127.0.0.1
